# ── Supabase (Dashboard → Project Settings → API) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# ── Google Sign-In: Web OAuth client ID only ──
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Used only in Supabase Dashboard → Auth → Google (never ship in the APK)
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Release signing (optional; leave blank for debug builds) ──
KINDLEAF_KEYSTORE_PATH=
KINDLEAF_KEYSTORE_PASSWORD=
KINDLEAF_KEY_ALIAS=
KINDLEAF_KEY_PASSWORD=

# ── Razorpay ──
# NOT set here. Razorpay keys live only in Supabase secrets (see supabase/README.md):
#   supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=... RAZORPAY_WEBHOOK_SECRET=...
